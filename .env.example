# ITernative Responsibility Quest - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_NAME=responsibility_quest
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Port for the frontend (default: 3000)
PORT=3000

# Node environment
NODE_ENV=production

# ===========================================
# OPTIONAL: AI INTEGRATIONS
# ===========================================
# ElevenLabs API for Jane voice (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Claude/OpenAI API for advanced Jane responses (optional)
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
